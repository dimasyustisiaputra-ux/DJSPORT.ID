{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Nama Worker di dashboard Cloudflare (alamat sementara: djsport.<akun>.workers.dev)
	"name": "djsport",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-17",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Optimasi gambar (next/image) memakai Cloudflare Images
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	// Nilai publik. Rahasia (KONVEXA_TOKEN, TURNSTILE_SECRET_KEY) diisi di dashboard Worker → Settings → Variables and Secrets.
	"vars": {
		"KONVEXA_URL": "https://konvexa.id"
	}
}
